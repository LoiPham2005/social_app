# Copy to .env
NODE_ENV=development
PORT=4000

# CORS origin (Next.js web)
WEB_ORIGIN=http://localhost:3000

# Database
DATABASE_URL="postgresql://social:social@localhost:5432/social?schema=public"

# Redis — toggle bật/tắt. false = app không kết nối Redis (dùng cho dev khi chưa cần).
REDIS_ENABLED=false
REDIS_URL="redis://localhost:6379"

# Storage (upload ảnh) — "local" (lưu đĩa) hoặc "cloudinary"
STORAGE_DRIVER=local
# URL công khai của API để build link ảnh khi dùng local
API_PUBLIC_URL=http://localhost:4000
# Chỉ cần khi STORAGE_DRIVER=cloudinary:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Web Push (VAPID) — sinh bằng: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_SUBJECT=mailto:admin@social.app
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# JWT — CHANGE THESE IN PRODUCTION
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_REFRESH_TTL=7d
