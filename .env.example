# Copy to .env and adjust. Used by docker-compose reference and apps.
# --- Database ---
DATABASE_URL="postgresql://social:social@localhost:5432/social?schema=public"
# --- Redis ---
# Bật/tắt Redis. Để trống = TẮT (docker compose up -d sẽ không chạy Redis).
# Bật: đặt COMPOSE_PROFILES=redis rồi `pnpm db:up`  (hoặc dùng `pnpm db:up:redis`).
COMPOSE_PROFILES=
REDIS_URL="redis://localhost:6379"
